# 复制为 .oss_backup.env（项目根）或 /etc/jiaowu/oss_backup.env 后填写，chmod 600
# 勿提交到 Git。
# 格式：KEY=value（不要写 export），供 run_oss_backup.sh 与 systemd EnvironmentFile 共用。

OSS_ACCESS_KEY_ID=LTAIxxxxxxxx
OSS_ACCESS_KEY_SECRET=xxxxxxxx
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=your-bucket-name

# 可选
# OSS_PREFIX=jiaowu-backups/prod/
# DATABASE_URL=sqlite:////opt/jiaowu/jiaowu.db
# OSS_BACKUP_SCAN_EXTRA_DB=1
# EXTRA_SQLITE_GLOBS=data/other.db
# OSS_BACKUP_LOG_DIR=/var/log/jiaowu
# 若定时任务用 root 且默认 python3 过旧，指定与 Flask 相同的解释器，例如：
# OSS_BACKUP_PYTHON=/usr/local/bin/python3
