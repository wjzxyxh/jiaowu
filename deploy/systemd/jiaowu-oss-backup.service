# 阿里云 OSS 数据库自动备份（oneshot，由 timer 触发）
#
# 安装步骤（root）：
#   1. 将项目部署到例如 /opt/jiaowu，并修改下面 WorkingDirectory、ExecStart 路径
#   2. sudo cp deploy/systemd/jiaowu-oss-backup.service /etc/systemd/system/
#   3. sudo cp deploy/systemd/jiaowu-oss-backup.timer /etc/systemd/system/
#   4. 创建 /etc/jiaowu/oss_backup.env（参考 scripts/oss_backup.env.example），chmod 600
#   5. sudo systemctl daemon-reload
#   6. sudo systemctl enable --now jiaowu-oss-backup.timer
#   7. sudo systemctl list-timers | grep jiaowu-oss-backup
#
# 立即试跑一次：
#   sudo systemctl start jiaowu-oss-backup.service
#   journalctl -u jiaowu-oss-backup.service -n 50

[Unit]
Description=Jiaowu database backup to Aliyun OSS (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 按实际部署用户修改（需能读数据库文件、执行 python3）
User=root
Group=root
WorkingDirectory=/opt/jiaowu
# 与 scripts/oss_backup.env.example 相同格式（KEY=value，一行一个）
EnvironmentFile=-/etc/jiaowu/oss_backup.env
ExecStart=/opt/jiaowu/scripts/run_oss_backup.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
